# VirPanel Configuration
APP_NAME=VirPanel
APP_ENV=production
APP_DEBUG=false
APP_URL=https://server.example.com:2087
APP_VERSION=0.1.0

# Server Configuration
SERVER_ADMIN_EMAIL=admin@example.com
SERVER_HOSTNAME=server.example.com
SERVER_PRIMARY_IP=192.168.1.100

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=virpanel
DB_USERNAME=virpanel
DB_PASSWORD=change_this_password
DB_PREFIX=sp_

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DATABASE=0

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=sp_cache

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_PREFIX=sp_queue

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# License Configuration
LICENSE_KEY=
LICENSE_SERVER=https://license.virpanel.com/api/v1
LICENSE_CHECK_INTERVAL=86400

# Security
APP_KEY=
JWT_SECRET=
HASH_ALGO=bcrypt
PASSWORD_MIN_LENGTH=12

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW=60

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_MAX_FILES=14

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_PATH=/var/virpanel/backups
BACKUP_RETENTION_DAYS=30

# SSL Configuration
SSL_AUTOSSL_ENABLED=true
SSL_PROVIDER=letsencrypt
LETSENCRYPT_EMAIL="${SERVER_ADMIN_EMAIL}"

# Web Server
WEB_SERVER=nginx
WEB_SERVER_USER=www-data
WEB_SERVER_GROUP=www-data

# PHP Configuration
PHP_DEFAULT_VERSION=8.1
PHP_FPM_PORT_START=9000

# DNS Configuration
DNS_SERVER=bind
DNS_CLUSTERING_ENABLED=false

# Email Server
EMAIL_SERVER=postfix
SPAM_FILTER=spamassassin
ANTIVIRUS=clamav

# FTP Server
FTP_SERVER=proftpd
FTP_PASSIVE_PORT_START=35000
FTP_PASSIVE_PORT_END=35999

# Monitoring
MONITORING_ENABLED=true
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false

# Development
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_HOST=localhost
