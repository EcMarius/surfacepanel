# Application
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
DATABASE_URL=postgresql://surfacepanel:surfacepanel@localhost:5432/surfacepanel
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=your-session-secret-change-in-production

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@surfacepanel.com

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=/var/surfacepanel/uploads

# User Files
USER_FILES_DIR=/var/surfacepanel/users
USER_DEFAULT_QUOTA=10737418240

# Backups
BACKUP_DIR=/var/surfacepanel/backups
BACKUP_RETENTION_DAYS=30

# SSL/TLS
ACME_EMAIL=admin@example.com
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# DNS
DNS_SERVER=127.0.0.1
DNS_ZONE_DIR=/etc/bind/zones

# Web Server
APACHE_SITES_DIR=/etc/apache2/sites-available
APACHE_SITES_ENABLED=/etc/apache2/sites-enabled
NGINX_SITES_DIR=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled

# FTP
FTP_PORT=21
FTP_PASV_MIN=30000
FTP_PASV_MAX=31000

# MySQL (for user databases)
MYSQL_ROOT_PASSWORD=your-mysql-root-password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Monitoring
ENABLE_MONITORING=true
MONITORING_INTERVAL=60000

# Logging
LOG_LEVEL=info
LOG_DIR=/var/log/surfacepanel

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Admin
DEFAULT_ADMIN_EMAIL=admin@surfacepanel.local
DEFAULT_ADMIN_PASSWORD=changeme123

# Features
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_REGISTRATION=false
ENABLE_AUTO_SSL=true

# AWS S3 (Optional - for remote backups)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# Cloudflare API (Optional - for DNS management)
CLOUDFLARE_API_TOKEN=
