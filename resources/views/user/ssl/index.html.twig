{% extends 'layouts/user.html.twig' %}

{% block title %}SSL/TLS Certificates{% endblock %}

{% block content %}
<div class="px-4 sm:px-6 lg:px-8" x-data="{ tab: 'certificates' }">
    <div class="sm:flex sm:items-center">
        <div class="sm:flex-auto">
            <h1 class="text-2xl font-semibold text-gray-900">SSL/TLS Certificates</h1>
            <p class="mt-2 text-sm text-gray-700">Secure your websites with SSL certificates</p>
        </div>
    </div>

    {% if app.session.get('success') %}
    <div class="mt-4 rounded-md bg-green-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-green-800">{{ app.session.get('success') }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    {% if app.session.get('error') %}
    <div class="mt-4 rounded-md bg-red-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-red-800">{{ app.session.get('error') }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Stats -->
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
            <dt class="truncate text-sm font-medium text-gray-500">Active Certificates</dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
                {{ certificates | filter(c => c.status == 'active') | length }}
            </dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
            <dt class="truncate text-sm font-medium text-gray-500">Let's Encrypt</dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
                {{ certificates | filter(c => c.type == 'letsencrypt') | length }}
            </dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
            <dt class="truncate text-sm font-medium text-gray-500">Available Domains</dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">{{ domains | length }}</dd>
        </div>
    </div>

    <!-- Tabs -->
    <div class="mt-8">
        <div class="border-b border-gray-200">
            <nav class="-mb-px flex space-x-8">
                <button @click="tab = 'certificates'" :class="tab === 'certificates' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium">
                    Installed Certificates ({{ certificates | length }})
                </button>
                <button @click="tab = 'letsencrypt'" :class="tab === 'letsencrypt' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium">
                    Let's Encrypt (Free SSL)
                </button>
                <button @click="tab = 'upload'" :class="tab === 'upload' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium">
                    Upload Certificate
                </button>
                <button @click="tab = 'csr'" :class="tab === 'csr' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium">
                    Generate CSR
                </button>
            </nav>
        </div>
    </div>

    <!-- Installed Certificates Tab -->
    <div x-show="tab === 'certificates'" class="mt-6">
        {% if certificates %}
        <div class="overflow-hidden bg-white shadow sm:rounded-lg">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Domain</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Issuer</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Expires</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    {% for cert in certificates %}
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                            <div class="flex items-center">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                                </svg>
                                {{ cert.domain }}
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {% if cert.type == 'letsencrypt' %}
                                <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold text-green-800">Let's Encrypt</span>
                            {% else %}
                                <span class="inline-flex rounded-full bg-blue-100 px-2 text-xs font-semibold text-blue-800">Custom</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ cert.issuer }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {% if cert.expires_at %}
                                {{ cert.expires_at | date('M d, Y') }}
                                {% set daysLeft = ((cert.expires_at | date('U')) - ('now' | date('U'))) / 86400 %}
                                {% if daysLeft < 30 %}
                                    <span class="ml-2 inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold text-red-800">{{ daysLeft | round }} days</span>
                                {% endif %}
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            {% if cert.status == 'active' %}
                                <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold text-green-800">Active</span>
                            {% else %}
                                <span class="inline-flex rounded-full bg-gray-100 px-2 text-xs font-semibold text-gray-800">Inactive</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm space-x-3">
                            {% if cert.type == 'letsencrypt' and cert.auto_renew %}
                                <form action="/user/ssl/{{ cert.id }}/renew" method="POST" class="inline">
                                    {{ csrf_field() | raw }}
                                    <button type="submit" class="text-blue-600 hover:text-blue-900">Renew</button>
                                </form>
                            {% endif %}
                            <form action="/user/ssl/{{ cert.id }}/delete" method="POST" class="inline" onsubmit="return confirm('Delete this certificate?');">
                                {{ csrf_field() | raw }}
                                <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-12 bg-white rounded-lg shadow">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            <p class="mt-2 text-sm text-gray-500">No SSL certificates installed yet. Get started with Let's Encrypt for free SSL.</p>
        </div>
        {% endif %}
    </div>

    <!-- Let's Encrypt Tab -->
    <div x-show="tab === 'letsencrypt'" class="mt-6">
        <div class="bg-white shadow sm:rounded-lg p-6">
            <div class="mb-6">
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <svg class="h-6 w-6 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-lg font-medium text-gray-900">Free SSL with Let's Encrypt</h3>
                        <p class="mt-2 text-sm text-gray-600">
                            Let's Encrypt provides free SSL certificates that are trusted by all major browsers.
                            Certificates are valid for 90 days and will automatically renew.
                        </p>
                    </div>
                </div>
            </div>

            <form action="/user/ssl/letsencrypt/issue" method="POST">
                {{ csrf_field() | raw }}
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Domain *</label>
                        <select name="domain" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                            <option value="">Select Domain</option>
                            {% for domain in domains %}
                            <option value="{{ domain }}">{{ domain }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Email Address *</label>
                        <input type="email" name="email" required placeholder="admin@example.com" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        <p class="mt-1 text-xs text-gray-500">For renewal and security notices</p>
                    </div>
                </div>
                <div class="mt-6">
                    <button type="submit" class="rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500">
                        Issue Free SSL Certificate
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Upload Certificate Tab -->
    <div x-show="tab === 'upload'" class="mt-6">
        <div class="bg-white shadow sm:rounded-lg p-6">
            <h3 class="text-lg font-medium mb-4">Upload Custom SSL Certificate</h3>
            <form action="/user/ssl/upload" method="POST">
                {{ csrf_field() | raw }}
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Domain *</label>
                        <select name="domain" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                            <option value="">Select Domain</option>
                            {% for domain in domains %}
                            <option value="{{ domain }}">{{ domain }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Certificate (CRT) *</label>
                        <textarea name="certificate" required rows="8" placeholder="-----BEGIN CERTIFICATE-----&#10;...&#10;-----END CERTIFICATE-----" class="mt-1 block w-full rounded-md border-gray-300 font-mono text-xs shadow-sm focus:border-blue-500 focus:ring-blue-500"></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Private Key *</label>
                        <textarea name="private_key" required rows="8" placeholder="-----BEGIN PRIVATE KEY-----&#10;...&#10;-----END PRIVATE KEY-----" class="mt-1 block w-full rounded-md border-gray-300 font-mono text-xs shadow-sm focus:border-blue-500 focus:ring-blue-500"></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Certificate Chain (Optional)</label>
                        <textarea name="chain" rows="6" placeholder="-----BEGIN CERTIFICATE-----&#10;...&#10;-----END CERTIFICATE-----" class="mt-1 block w-full rounded-md border-gray-300 font-mono text-xs shadow-sm focus:border-blue-500 focus:ring-blue-500"></textarea>
                    </div>
                </div>
                <div class="mt-6">
                    <button type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                        Upload & Install Certificate
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Generate CSR Tab -->
    <div x-show="tab === 'csr'" class="mt-6">
        <div class="bg-white shadow sm:rounded-lg p-6">
            <h3 class="text-lg font-medium mb-4">Generate Certificate Signing Request (CSR)</h3>

            {% if app.session.get('csr') %}
            <div class="mb-6 space-y-4">
                <div class="rounded-md bg-green-50 p-4">
                    <p class="text-sm text-green-800 font-medium">CSR Generated Successfully!</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Certificate Signing Request (CSR)</label>
                    <textarea readonly rows="10" class="block w-full rounded-md border-gray-300 font-mono text-xs bg-gray-50">{{ app.session.get('csr') }}</textarea>
                    <p class="mt-2 text-xs text-gray-500">Submit this CSR to your certificate authority</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Private Key (Keep Secure!)</label>
                    <textarea readonly rows="10" class="block w-full rounded-md border-gray-300 font-mono text-xs bg-gray-50">{{ app.session.get('csr_private_key') }}</textarea>
                    <p class="mt-2 text-xs text-red-600">Save this private key securely. You'll need it to install your certificate.</p>
                </div>
            </div>
            {% endif %}

            <form action="/user/ssl/csr/generate" method="POST">
                {{ csrf_field() | raw }}
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Domain (Common Name) *</label>
                        <select name="domain" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                            <option value="">Select Domain</option>
                            {% for domain in domains %}
                            <option value="{{ domain }}">{{ domain }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Email Address</label>
                        <input type="email" name="email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Country (2-letter code)</label>
                        <input type="text" name="country" maxlength="2" placeholder="US" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">State/Province</label>
                        <input type="text" name="state" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">City/Locality</label>
                        <input type="text" name="city" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Organization</label>
                        <input type="text" name="organization" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    </div>
                </div>
                <div class="mt-6">
                    <button type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                        Generate CSR
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
