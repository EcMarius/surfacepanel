{% extends 'layouts/admin.html.twig' %}

{% block title %}Account Details - {{ account.username }}{% endblock %}

{% block content %}
<div class="px-4 sm:px-6 lg:px-8">
    <div class="sm:flex sm:items-center">
        <div class="sm:flex-auto">
            <h1 class="text-2xl font-semibold text-gray-900">Account: {{ account.username }}</h1>
            <p class="mt-2 text-sm text-gray-700">{{ account.domain }}</p>
        </div>
        <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none space-x-3">
            <a href="/admin/accounts/{{ account.id }}/edit" class="inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                Edit Account
            </a>
            <a href="/admin/accounts" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                Back to Accounts
            </a>
        </div>
    </div>

    {% if app.session.get('success') %}
    <div class="mt-4 rounded-md bg-green-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-green-800">{{ app.session.get('success') }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
        <!-- Account Information -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Status Card -->
            <div class="overflow-hidden bg-white shadow sm:rounded-lg">
                <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
                    <div>
                        <h3 class="text-lg font-medium leading-6 text-gray-900">Account Status</h3>
                    </div>
                    <div>
                        {% if account.status == 'active' %}
                            <span class="inline-flex rounded-full bg-green-100 px-3 py-1 text-sm font-semibold text-green-800">Active</span>
                        {% elseif account.status == 'suspended' %}
                            <span class="inline-flex rounded-full bg-yellow-100 px-3 py-1 text-sm font-semibold text-yellow-800">Suspended</span>
                        {% else %}
                            <span class="inline-flex rounded-full bg-red-100 px-3 py-1 text-sm font-semibold text-red-800">Terminated</span>
                        {% endif %}
                    </div>
                </div>
                <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
                    <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
                        <div class="sm:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Username</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ account.username }}</dd>
                        </div>
                        <div class="sm:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Email</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ account.email }}</dd>
                        </div>
                        <div class="sm:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Package</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ account.package_name }}</dd>
                        </div>
                        <div class="sm:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Owner</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ account.owner_username }}</dd>
                        </div>
                        <div class="sm:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Created</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ account.created_at | date('F j, Y g:i A') }}</dd>
                        </div>
                        <div class="sm:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Last Updated</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ account.updated_at | date('F j, Y g:i A') }}</dd>
                        </div>
                    </dl>

                    {% if account.status == 'suspended' and account.suspension_reason %}
                    <div class="mt-6">
                        <dt class="text-sm font-medium text-gray-500">Suspension Reason</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ account.suspension_reason }}</dd>
                        <dd class="mt-1 text-sm text-gray-500">Suspended on {{ account.suspended_at | date('F j, Y g:i A') }}</dd>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Resource Usage -->
            <div class="overflow-hidden bg-white shadow sm:rounded-lg">
                <div class="px-4 py-5 sm:px-6">
                    <h3 class="text-lg font-medium leading-6 text-gray-900">Resource Usage</h3>
                </div>
                <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
                    <dl class="space-y-6">
                        <!-- Disk Usage -->
                        <div>
                            <div class="flex justify-between text-sm">
                                <dt class="font-medium text-gray-500">Disk Usage</dt>
                                <dd class="text-gray-900">
                                    {{ (account.disk_used / 1024 / 1024) | round(2) }} MB /
                                    {% if account.disk_quota == 0 %}
                                        Unlimited
                                    {% else %}
                                        {{ (account.disk_quota / 1024) | round(2) }} GB
                                    {% endif %}
                                </dd>
                            </div>
                            {% if account.disk_quota > 0 %}
                            <div class="mt-2 w-full bg-gray-200 rounded-full h-2">
                                {% set diskPercent = (account.disk_used / account.disk_quota * 100) | round %}
                                <div class="bg-blue-600 h-2 rounded-full" style="width: {{ min(diskPercent, 100) }}%"></div>
                            </div>
                            <p class="mt-1 text-xs text-gray-500">{{ diskPercent }}% used</p>
                            {% endif %}
                        </div>

                        <!-- Bandwidth Usage -->
                        <div>
                            <div class="flex justify-between text-sm">
                                <dt class="font-medium text-gray-500">Bandwidth Usage (This Month)</dt>
                                <dd class="text-gray-900">
                                    {{ (account.bandwidth_used / 1024 / 1024) | round(2) }} MB /
                                    {% if account.bandwidth_quota == 0 %}
                                        Unlimited
                                    {% else %}
                                        {{ (account.bandwidth_quota / 1024) | round(2) }} GB
                                    {% endif %}
                                </dd>
                            </div>
                            {% if account.bandwidth_quota > 0 %}
                            <div class="mt-2 w-full bg-gray-200 rounded-full h-2">
                                {% set bwPercent = (account.bandwidth_used / account.bandwidth_quota * 100) | round %}
                                <div class="bg-green-600 h-2 rounded-full" style="width: {{ min(bwPercent, 100) }}%"></div>
                            </div>
                            <p class="mt-1 text-xs text-gray-500">{{ bwPercent }}% used</p>
                            {% endif %}
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Domains -->
            <div class="overflow-hidden bg-white shadow sm:rounded-lg">
                <div class="px-4 py-5 sm:px-6">
                    <h3 class="text-lg font-medium leading-6 text-gray-900">Domains</h3>
                </div>
                <div class="border-t border-gray-200">
                    <ul role="list" class="divide-y divide-gray-200">
                        {% for domain in domains %}
                        <li class="px-4 py-4 sm:px-6">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-gray-900">{{ domain.domain }}</p>
                                    <p class="text-sm text-gray-500">
                                        {% if domain.type == 'main' %}
                                            <span class="inline-flex rounded-full bg-blue-100 px-2 text-xs font-semibold text-blue-800">Main Domain</span>
                                        {% elseif domain.type == 'addon' %}
                                            <span class="inline-flex rounded-full bg-purple-100 px-2 text-xs font-semibold text-purple-800">Addon Domain</span>
                                        {% elseif domain.type == 'subdomain' %}
                                            <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold text-green-800">Subdomain</span>
                                        {% else %}
                                            <span class="inline-flex rounded-full bg-gray-100 px-2 text-xs font-semibold text-gray-800">Parked Domain</span>
                                        {% endif %}
                                        {% if domain.ssl_enabled %}
                                            <span class="ml-2 inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold text-green-800">SSL</span>
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="ml-4">
                                    {% if domain.is_active %}
                                        <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold text-green-800">Active</span>
                                    {% else %}
                                        <span class="inline-flex rounded-full bg-gray-100 px-2 text-xs font-semibold text-gray-800">Inactive</span>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                        {% else %}
                        <li class="px-4 py-8 sm:px-6 text-center text-sm text-gray-500">
                            No domains found
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        <!-- Actions Sidebar -->
        <div class="space-y-6">
            <!-- Quick Stats -->
            <div class="overflow-hidden bg-white shadow sm:rounded-lg">
                <div class="px-4 py-5 sm:px-6">
                    <h3 class="text-lg font-medium leading-6 text-gray-900">Quick Stats</h3>
                </div>
                <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
                    <dl class="space-y-4">
                        <div class="flex justify-between">
                            <dt class="text-sm text-gray-500">Domains</dt>
                            <dd class="text-sm font-semibold text-gray-900">{{ domains | length }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-sm text-gray-500">Databases</dt>
                            <dd class="text-sm font-semibold text-gray-900">{{ dbCount }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-sm text-gray-500">Email Accounts</dt>
                            <dd class="text-sm font-semibold text-gray-900">{{ emailCount }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Actions -->
            <div class="overflow-hidden bg-white shadow sm:rounded-lg">
                <div class="px-4 py-5 sm:px-6">
                    <h3 class="text-lg font-medium leading-6 text-gray-900">Actions</h3>
                </div>
                <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
                    <div class="space-y-3">
                        {% if account.status == 'active' %}
                        <form action="/admin/accounts/{{ account.id }}/suspend" method="POST" onsubmit="return confirm('Are you sure you want to suspend this account?');">
                            <input type="hidden" name="reason" value="Administrative action">
                            {{ csrf_field() | raw }}
                            <button type="submit" class="w-full rounded-md bg-yellow-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-yellow-500">
                                Suspend Account
                            </button>
                        </form>
                        {% elseif account.status == 'suspended' %}
                        <form action="/admin/accounts/{{ account.id }}/unsuspend" method="POST">
                            {{ csrf_field() | raw }}
                            <button type="submit" class="w-full rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500">
                                Unsuspend Account
                            </button>
                        </form>
                        {% endif %}

                        <button type="button" onclick="window.location.href='/admin/filemanager/{{ account.id }}'" class="w-full rounded-md bg-purple-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500">
                            File Manager
                        </button>

                        <button type="button" onclick="window.location.href='/admin/accounts/{{ account.id }}/change-password'" class="w-full rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                            Change Password
                        </button>

                        <button type="button" onclick="window.location.href='/admin/accounts/{{ account.id }}/change-package'" class="w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
                            Change Package
                        </button>

                        <form action="/admin/accounts/{{ account.id }}" method="POST" onsubmit="return confirm('Are you sure you want to terminate this account? This action cannot be undone!');">
                            <input type="hidden" name="_method" value="DELETE">
                            {{ csrf_field() | raw }}
                            <button type="submit" class="w-full rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500">
                                Terminate Account
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Login Information -->
            <div class="overflow-hidden bg-white shadow sm:rounded-lg">
                <div class="px-4 py-5 sm:px-6">
                    <h3 class="text-lg font-medium leading-6 text-gray-900">Login Information</h3>
                </div>
                <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
                    <dl class="space-y-3">
                        <div>
                            <dt class="text-xs font-medium text-gray-500">cPanel URL</dt>
                            <dd class="mt-1 text-sm text-gray-900 font-mono">https://{{ account.domain }}:2083</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-gray-500">Username</dt>
                            <dd class="mt-1 text-sm text-gray-900 font-mono">{{ account.username }}</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
