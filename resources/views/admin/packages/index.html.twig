{% extends 'layouts/admin.html.twig' %}

{% block title %}Package Management{% endblock %}

{% block content %}
<div class="px-4 sm:px-6 lg:px-8">
    <div class="sm:flex sm:items-center">
        <div class="sm:flex-auto">
            <h1 class="text-2xl font-semibold text-gray-900">Packages</h1>
            <p class="mt-2 text-sm text-gray-700">Define hosting packages with resource limits and features</p>
        </div>
        <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
            <a href="/admin/packages/create" class="block rounded-md bg-blue-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                Create Package
            </a>
        </div>
    </div>

    {% if app.session.get('success') %}
    <div class="mt-4 rounded-md bg-green-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-green-800">{{ app.session.get('success') }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    {% if app.session.get('error') %}
    <div class="mt-4 rounded-md bg-red-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-red-800">{{ app.session.get('error') }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Packages grid -->
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for package in packages %}
        <div class="overflow-hidden bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
            <div class="px-6 py-5">
                <div class="flex items-center justify-between">
                    <h3 class="text-lg font-semibold leading-6 text-gray-900">{{ package.name }}</h3>
                    {% if package.is_active %}
                        <span class="inline-flex rounded-full bg-green-100 px-2 py-1 text-xs font-semibold text-green-800">Active</span>
                    {% else %}
                        <span class="inline-flex rounded-full bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-800">Inactive</span>
                    {% endif %}
                </div>
                {% if package.description %}
                <p class="mt-2 text-sm text-gray-500">{{ package.description }}</p>
                {% endif %}

                <dl class="mt-6 space-y-3 text-sm">
                    <div class="flex justify-between">
                        <dt class="text-gray-500">Disk Space</dt>
                        <dd class="font-medium text-gray-900">
                            {% if package.disk_quota == 0 %}
                                Unlimited
                            {% else %}
                                {{ (package.disk_quota / 1024 / 1024) | round(0) }} MB
                            {% endif %}
                        </dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-gray-500">Bandwidth</dt>
                        <dd class="font-medium text-gray-900">
                            {% if package.bandwidth_quota == 0 %}
                                Unlimited
                            {% else %}
                                {{ (package.bandwidth_quota / 1024 / 1024) | round(0) }} MB
                            {% endif %}
                        </dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-gray-500">Domains</dt>
                        <dd class="font-medium text-gray-900">{{ package.max_domains == 0 ? 'Unlimited' : package.max_domains }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-gray-500">Email Accounts</dt>
                        <dd class="font-medium text-gray-900">{{ package.max_emails == 0 ? 'Unlimited' : package.max_emails }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-gray-500">Databases</dt>
                        <dd class="font-medium text-gray-900">{{ package.max_databases == 0 ? 'Unlimited' : package.max_databases }}</dd>
                    </div>
                </dl>

                <div class="mt-6 flex flex-wrap gap-2 text-xs">
                    {% if package.ssh_access %}
                        <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">SSH Access</span>
                    {% endif %}
                    {% if package.cron_jobs %}
                        <span class="inline-flex items-center rounded-md bg-purple-50 px-2 py-1 font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">Cron Jobs</span>
                    {% endif %}
                    {% if package.backup_access %}
                        <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 font-medium text-green-700 ring-1 ring-inset ring-green-700/10">Backups</span>
                    {% endif %}
                </div>

                <div class="mt-6 flex items-center justify-between border-t border-gray-200 pt-4">
                    <p class="text-sm text-gray-500">
                        {{ package.account_count }} account{{ package.account_count != 1 ? 's' : '' }}
                    </p>
                    <div class="flex gap-2">
                        <a href="/admin/packages/{{ package.id }}" class="text-sm font-medium text-blue-600 hover:text-blue-500">
                            View
                        </a>
                        <a href="/admin/packages/{{ package.id }}/edit" class="text-sm font-medium text-blue-600 hover:text-blue-500">
                            Edit
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-span-full rounded-lg border-2 border-dashed border-gray-300 p-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
            </svg>
            <h3 class="mt-2 text-sm font-semibold text-gray-900">No packages</h3>
            <p class="mt-1 text-sm text-gray-500">Get started by creating a new hosting package.</p>
            <div class="mt-6">
                <a href="/admin/packages/create" class="inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                    <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                    </svg>
                    New Package
                </a>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
