{% extends 'layouts/admin.html.twig' %}

{% block title %}Module Management{% endblock %}

{% block content %}
<div class="px-4 sm:px-6 lg:px-8" x-data="moduleManager()">
    <div class="sm:flex sm:items-center">
        <div class="sm:flex-auto">
            <h1 class="text-2xl font-semibold text-gray-900">Modules</h1>
            <p class="mt-2 text-sm text-gray-700">Manage and install modules to extend VirPanel functionality</p>
        </div>
        <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
            <button @click="showUpload = true" class="block rounded-md bg-blue-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                Upload Module
            </button>
        </div>
    </div>

    {% if app.session.get('success') %}
    <div class="mt-4 rounded-md bg-green-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-green-800">{{ app.session.get('success') }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    {% if app.session.get('error') %}
    <div class="mt-4 rounded-md bg-red-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-red-800">{{ app.session.get('error') }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Upload Modal -->
    <div x-show="showUpload" class="fixed inset-0 z-50 overflow-y-auto" style="display: none;">
        <div class="flex min-h-screen items-end justify-center px-4 pb-20 pt-4 text-center sm:block sm:p-0">
            <div @click="showUpload = false" class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
            <div class="inline-block align-bottom bg-white rounded-lg px-4 pb-4 pt-5 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">
                <form action="/admin/modules/upload" method="POST" enctype="multipart/form-data">
                    {{ csrf_field() | raw }}
                    <div>
                        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-100">
                            <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 8.25H7.5a2.25 2.25 0 00-2.25 2.25v9a2.25 2.25 0 002.25 2.25h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25H15m0-3l-3-3m0 0l-3 3m3-3V15" />
                            </svg>
                        </div>
                        <div class="mt-3 text-center sm:mt-5">
                            <h3 class="text-lg font-medium leading-6 text-gray-900">Upload Module</h3>
                            <div class="mt-4">
                                <div class="flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md">
                                    <div class="space-y-1 text-center">
                                        <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                        <div class="flex text-sm text-gray-600">
                                            <label for="module_file" class="relative cursor-pointer rounded-md bg-white font-medium text-blue-600 hover:text-blue-500">
                                                <span>Upload a file</span>
                                                <input id="module_file" name="module_file" type="file" accept=".zip" required class="sr-only">
                                            </label>
                                            <p class="pl-1">or drag and drop</p>
                                        </div>
                                        <p class="text-xs text-gray-500">ZIP files up to 50MB</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3">
                        <button type="submit" class="inline-flex w-full justify-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 sm:col-start-2">
                            Upload & Install
                        </button>
                        <button @click="showUpload = false" type="button" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:col-start-1 sm:mt-0">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modules Grid -->
    <div class="mt-8">
        {% if modules %}
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {% for module in modules %}
            <div class="overflow-hidden bg-white shadow sm:rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <div class="flex items-center justify-between">
                        <div class="flex-1">
                            <h3 class="text-lg font-medium text-gray-900">{{ module.name }}</h3>
                            <p class="mt-1 text-sm text-gray-500">v{{ module.version }}</p>
                        </div>
                        <div>
                            {% if module.enabled %}
                                <span class="inline-flex rounded-full bg-green-100 px-2 py-1 text-xs font-semibold text-green-800">Enabled</span>
                            {% else %}
                                <span class="inline-flex rounded-full bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-800">Disabled</span>
                            {% endif %}
                        </div>
                    </div>

                    <p class="mt-3 text-sm text-gray-600">{{ module.description | default('No description available') }}</p>

                    {% if module.author %}
                    <p class="mt-2 text-xs text-gray-500">
                        By {{ module.author }}
                    </p>
                    {% endif %}

                    <!-- Module Actions -->
                    <div class="mt-4 flex gap-2">
                        {% if module.enabled %}
                        <form action="/admin/modules/{{ module.directory }}/disable" method="POST" class="flex-1">
                            {{ csrf_field() | raw }}
                            <button type="submit" class="w-full rounded-md bg-yellow-600 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-yellow-500">
                                Disable
                            </button>
                        </form>
                        {% else %}
                        <form action="/admin/modules/{{ module.directory }}/enable" method="POST" class="flex-1">
                            {{ csrf_field() | raw }}
                            <button type="submit" class="w-full rounded-md bg-green-600 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-green-500">
                                Enable
                            </button>
                        </form>
                        {% endif %}

                        <form action="/admin/modules/{{ module.directory }}/uninstall" method="POST" class="flex-1" onsubmit="return confirm('Are you sure you want to uninstall this module? This action cannot be undone.');">
                            {{ csrf_field() | raw }}
                            <button type="submit" class="w-full rounded-md bg-red-600 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-red-500">
                                Uninstall
                            </button>
                        </form>
                    </div>

                    <!-- Module Info -->
                    {% if module.dependencies %}
                    <div class="mt-3 pt-3 border-t border-gray-200">
                        <p class="text-xs text-gray-500">
                            <span class="font-medium">Dependencies:</span>
                            {{ module.dependencies | keys | join(', ') }}
                        </p>
                    </div>
                    {% endif %}

                    {% if module.homepage %}
                    <div class="mt-2">
                        <a href="{{ module.homepage }}" target="_blank" class="text-xs text-blue-600 hover:text-blue-500">
                            Visit Homepage →
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No modules installed</h3>
            <p class="mt-1 text-sm text-gray-500">Get started by uploading a module package</p>
            <div class="mt-6">
                <button @click="showUpload = true" class="inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                    <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                    </svg>
                    Upload Module
                </button>
            </div>
        </div>
        {% endif %}
    </div>

    <!-- Module Development Guide -->
    <div class="mt-12 bg-blue-50 rounded-lg p-6">
        <h3 class="text-lg font-medium text-blue-900">Module Development</h3>
        <p class="mt-2 text-sm text-blue-700">
            Want to create your own module? Modules are packaged as ZIP files containing a module.json manifest and your module class.
        </p>
        <div class="mt-4">
            <details class="text-sm text-blue-700">
                <summary class="cursor-pointer font-medium">View module.json example</summary>
                <pre class="mt-2 bg-blue-100 rounded p-3 overflow-x-auto"><code>{
  "name": "my-module",
  "version": "1.0.0",
  "class": "MyModule\\MyModule",
  "description": "A sample module for VirPanel",
  "author": "Your Name",
  "homepage": "https://example.com",
  "dependencies": {},
  "enabled": true
}</code></pre>
            </details>
        </div>
    </div>
</div>

<script>
function moduleManager() {
    return {
        showUpload: false
    }
}
</script>
{% endblock %}
