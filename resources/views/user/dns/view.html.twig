{% extends "layouts/user.html.twig" %}

{% block title %}DNS Records for {{ zone.domain }} - VirPanel{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center mb-2">
            <a href="/user/dns" class="text-blue-600 hover:text-blue-800 mr-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-3xl font-bold text-gray-800">DNS Records for {{ zone.domain }}</h1>
        </div>
        <p class="text-gray-600">Zone Serial: {{ zone.serial }}</p>
    </div>

    <!-- Success/Error Messages -->
    {% if session_has('success') %}
    <div class="bg-green-50 border-l-4 border-green-400 p-4 mb-6">
        <p class="text-green-700">{{ session_get('success') }}</p>
    </div>
    {% endif %}

    {% if session_has('error') %}
    <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6">
        <p class="text-red-700">{{ session_get('error') }}</p>
    </div>
    {% endif %}

    <!-- Add Record Form -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8" x-data="{ recordType: 'A' }">
        <h2 class="text-xl font-semibold mb-4">Add DNS Record</h2>

        <form method="POST" action="/user/dns/zone/{{ zone.id }}/add" class="space-y-4">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Name *</label>
                    <input
                        type="text"
                        name="name"
                        required
                        placeholder="@"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    >
                    <p class="text-xs text-gray-500 mt-1">Use @ for root domain</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Type *</label>
                    <select
                        name="type"
                        x-model="recordType"
                        required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    >
                        <option value="A">A</option>
                        <option value="AAAA">AAAA</option>
                        <option value="CNAME">CNAME</option>
                        <option value="MX">MX</option>
                        <option value="TXT">TXT</option>
                        <option value="NS">NS</option>
                        <option value="SRV">SRV</option>
                        <option value="CAA">CAA</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">TTL</label>
                    <select
                        name="ttl"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    >
                        <option value="300">5 minutes</option>
                        <option value="1800">30 minutes</option>
                        <option value="3600">1 hour</option>
                        <option value="14400" selected>4 hours</option>
                        <option value="86400">1 day</option>
                    </select>
                </div>

                <div x-show="recordType === 'MX' || recordType === 'SRV'">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Priority</label>
                    <input
                        type="number"
                        name="priority"
                        value="10"
                        min="0"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    >
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Content *</label>
                <input
                    type="text"
                    name="content"
                    required
                    :placeholder="recordType === 'A' ? '192.168.1.1' : (recordType === 'AAAA' ? '2001:db8::1' : (recordType === 'CNAME' ? 'example.com.' : (recordType === 'MX' ? 'mail.example.com.' : (recordType === 'TXT' ? '\"v=spf1 a mx ~all\"' : ''))))"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                >
                <div class="mt-2 text-xs text-gray-500">
                    <div x-show="recordType === 'A'">Enter IPv4 address (e.g., 192.168.1.1)</div>
                    <div x-show="recordType === 'AAAA'">Enter IPv6 address (e.g., 2001:db8::1)</div>
                    <div x-show="recordType === 'CNAME'">Enter target hostname with trailing dot (e.g., example.com.)</div>
                    <div x-show="recordType === 'MX'">Enter mail server hostname with trailing dot (e.g., mail.example.com.)</div>
                    <div x-show="recordType === 'TXT'">Enter text value in quotes (e.g., "v=spf1 a mx ~all")</div>
                    <div x-show="recordType === 'NS'">Enter nameserver hostname with trailing dot</div>
                </div>
            </div>

            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium transition">
                Add Record
            </button>
        </form>
    </div>

    <!-- DNS Records Table -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-xl font-semibold">DNS Records</h2>
        </div>

        {% if records is empty %}
        <div class="p-8 text-center text-gray-500">
            <p>No DNS records found</p>
        </div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">TTL</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Priority</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Content</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for record in records %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="text-sm font-mono text-gray-900">{{ record.name }}</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 py-1 text-xs font-semibold rounded {% if record.type == 'A' or record.type == 'AAAA' %}bg-blue-100 text-blue-800{% elseif record.type == 'MX' %}bg-purple-100 text-purple-800{% elseif record.type == 'TXT' %}bg-green-100 text-green-800{% elseif record.type == 'CNAME' %}bg-yellow-100 text-yellow-800{% else %}bg-gray-100 text-gray-800{% endif %}">
                                {{ record.type }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {{ record.ttl }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {% if record.priority > 0 %}{{ record.priority }}{% else %}-{% endif %}
                        </td>
                        <td class="px-6 py-4">
                            <span class="text-sm font-mono text-gray-900 break-all">{{ record.content }}</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            {% if record.type != 'SOA' %}
                            <form method="POST" action="/user/dns/zone/{{ zone.id }}/record/{{ record.id }}/delete" class="inline" onsubmit="return confirm('Delete this DNS record?')">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                            </form>
                            {% else %}
                            <span class="text-gray-400 text-xs">Protected</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <!-- Common Record Templates -->
    <div class="mt-8 bg-gray-50 rounded-lg p-6">
        <h3 class="text-lg font-semibold mb-4">Common DNS Record Examples</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div>
                <h4 class="font-medium text-gray-700 mb-2">A Record (IPv4)</h4>
                <div class="bg-white rounded p-3 font-mono text-xs">
                    Name: @<br>
                    Type: A<br>
                    Content: 192.168.1.1
                </div>
            </div>
            <div>
                <h4 class="font-medium text-gray-700 mb-2">CNAME Record</h4>
                <div class="bg-white rounded p-3 font-mono text-xs">
                    Name: www<br>
                    Type: CNAME<br>
                    Content: {{ zone.domain }}.
                </div>
            </div>
            <div>
                <h4 class="font-medium text-gray-700 mb-2">MX Record (Email)</h4>
                <div class="bg-white rounded p-3 font-mono text-xs">
                    Name: @<br>
                    Type: MX<br>
                    Priority: 10<br>
                    Content: mail.{{ zone.domain }}.
                </div>
            </div>
            <div>
                <h4 class="font-medium text-gray-700 mb-2">TXT Record (SPF)</h4>
                <div class="bg-white rounded p-3 font-mono text-xs">
                    Name: @<br>
                    Type: TXT<br>
                    Content: "v=spf1 a mx ~all"
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
{% endblock %}
