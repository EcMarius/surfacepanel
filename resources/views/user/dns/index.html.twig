{% extends "layouts/user.html.twig" %}

{% block title %}DNS Zone Manager - VirPanel{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800">DNS Zone Manager</h1>
        <p class="text-gray-600 mt-2">Manage DNS zones and records for your domains</p>
    </div>

    <!-- Success/Error Messages -->
    {% if session_has('success') %}
    <div class="bg-green-50 border-l-4 border-green-400 p-4 mb-6">
        <p class="text-green-700">{{ session_get('success') }}</p>
    </div>
    {% endif %}

    {% if session_has('error') %}
    <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6">
        <p class="text-red-700">{{ session_get('error') }}</p>
    </div>
    {% endif %}

    <!-- Info Box -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8">
        <div class="flex items-start">
            <svg class="w-6 h-6 text-blue-500 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
                <h3 class="text-lg font-semibold text-blue-900 mb-2">DNS Zone Management</h3>
                <p class="text-blue-800 mb-2">
                    Create and manage DNS zones for your domains. Each zone contains DNS records (A, AAAA, CNAME, MX, TXT, etc.) that control how your domain resolves.
                </p>
                <p class="text-blue-700 text-sm">
                    Note: DNS changes may take up to 24-48 hours to propagate worldwide.
                </p>
            </div>
        </div>
    </div>

    <!-- Create Zone Form -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-xl font-semibold mb-4">Create New DNS Zone</h2>

        <form method="POST" action="/user/dns/create" class="space-y-4">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Domain *
                </label>
                <select
                    name="domain"
                    required
                    class="w-full md:w-1/2 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                >
                    <option value="">Select a domain...</option>
                    {% for domain in domains %}
                    <option value="{{ domain }}">{{ domain }}</option>
                    {% endfor %}
                </select>
                <p class="text-xs text-gray-500 mt-1">Select the domain to create a DNS zone for</p>
            </div>

            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium transition">
                Create DNS Zone
            </button>
        </form>
    </div>

    <!-- Existing DNS Zones -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-xl font-semibold">Your DNS Zones</h2>
        </div>

        {% if zones is empty %}
        <div class="p-8 text-center text-gray-500">
            <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
            </svg>
            <p>No DNS zones created yet</p>
            <p class="text-sm mt-2">Create a DNS zone to start managing DNS records</p>
        </div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Domain</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Records</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Serial</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for zone in zones %}
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
                                </svg>
                                <div>
                                    <div class="text-sm font-medium text-gray-900">{{ zone.domain }}</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">
                                {{ zone.record_count }} records
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {{ zone.serial }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            {% if zone.status == 'active' %}
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Active</span>
                            {% else %}
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Inactive</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {{ zone.created_at|date('M d, Y') }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm space-x-3">
                            <a href="/user/dns/zone/{{ zone.id }}" class="text-blue-600 hover:text-blue-900">Manage Records</a>
                            <form method="POST" action="/user/dns/zone/{{ zone.id }}/delete" class="inline" onsubmit="return confirm('Delete this DNS zone and all its records?')">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <!-- DNS Information -->
    <div class="mt-8 bg-gray-50 rounded-lg p-6">
        <h3 class="text-lg font-semibold mb-4">Nameservers</h3>
        <p class="text-sm text-gray-600 mb-3">Point your domain to these nameservers at your registrar:</p>
        <div class="space-y-2">
            <div class="bg-white rounded px-4 py-2 font-mono text-sm">
                ns1.virpanel.com
            </div>
            <div class="bg-white rounded px-4 py-2 font-mono text-sm">
                ns2.virpanel.com
            </div>
        </div>
    </div>
</div>
{% endblock %}
