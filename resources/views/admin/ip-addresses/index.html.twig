{% extends 'layouts/admin.html.twig' %}

{% block title %}IP Address Management{% endblock %}

{% block content %}
<div class="px-4 sm:px-6 lg:px-8">
    <div class="sm:flex sm:items-center">
        <div class="sm:flex-auto">
            <h1 class="text-2xl font-semibold text-gray-900">IP Address Management</h1>
            <p class="mt-2 text-sm text-gray-700">Manage server IP addresses for shared and dedicated hosting</p>
        </div>
        <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
            <button onclick="document.getElementById('addIPForm').classList.toggle('hidden')" class="block rounded-md bg-blue-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                Add IP Address
            </button>
        </div>
    </div>

    {% if app.session.get('success') %}
    <div class="mt-4 rounded-md bg-green-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-green-800">{{ app.session.get('success') }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    {% if app.session.get('error') %}
    <div class="mt-4 rounded-md bg-red-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-red-800">{{ app.session.get('error') }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Stats -->
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-4">
        <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
            <dt class="truncate text-sm font-medium text-gray-500">Total IPs</dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">{{ totalIPs }}</dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
            <dt class="truncate text-sm font-medium text-gray-500">Shared IPs</dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-blue-600">{{ sharedIPs }}</dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
            <dt class="truncate text-sm font-medium text-gray-500">Dedicated IPs</dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-purple-600">{{ dedicatedIPs }}</dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
            <dt class="truncate text-sm font-medium text-gray-500">Available</dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-green-600">{{ availableIPs }}</dd>
        </div>
    </div>

    <!-- Add IP Form -->
    <div id="addIPForm" class="hidden mt-6 bg-white shadow sm:rounded-lg p-6">
        <h3 class="text-lg font-medium mb-4">Add IP Address to Pool</h3>
        <form action="/admin/ip-addresses" method="POST">
            {{ csrf_field() | raw }}
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                    <label class="block text-sm font-medium text-gray-700">IP Address *</label>
                    <input type="text" name="ip_address" required placeholder="192.168.1.100 or 2001:db8::1" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Type *</label>
                    <select name="type" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        <option value="shared">Shared (Multiple accounts)</option>
                        <option value="dedicated">Dedicated (Single account)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Nameserver (Optional)</label>
                    <input type="text" name="nameserver" placeholder="ns1.example.com" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>
            </div>
            <div class="mt-4 flex gap-3">
                <button type="submit" class="rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                    Add IP Address
                </button>
                <button type="button" onclick="document.getElementById('addIPForm').classList.add('hidden')" class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    Cancel
                </button>
            </div>
        </form>
    </div>

    <!-- IP Addresses Table -->
    <div class="mt-8 overflow-hidden bg-white shadow sm:rounded-lg">
        {% if ipAddresses %}
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP Address</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Version</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Accounts</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">PTR Record</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
                {% for ip in ipAddresses %}
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <span class="text-sm font-medium text-gray-900">{{ ip.ip_address }}</span>
                            {% if ip.is_default %}
                                <span class="ml-2 inline-flex rounded-full bg-blue-100 px-2 text-xs font-semibold text-blue-800">Default</span>
                            {% endif %}
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        {{ ip.ip_version }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                        {% if ip.type == 'shared' %}
                            <span class="inline-flex rounded-full bg-blue-100 px-2 text-xs font-semibold text-blue-800">Shared</span>
                        {% else %}
                            <span class="inline-flex rounded-full bg-purple-100 px-2 text-xs font-semibold text-purple-800">Dedicated</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                        {% if ip.status == 'available' %}
                            <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold text-green-800">Available</span>
                        {% elseif ip.status == 'assigned' %}
                            <span class="inline-flex rounded-full bg-yellow-100 px-2 text-xs font-semibold text-yellow-800">Assigned</span>
                        {% else %}
                            <span class="inline-flex rounded-full bg-gray-100 px-2 text-xs font-semibold text-gray-800">{{ ip.status }}</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        {{ ip.account_count }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        {% if ip.ptr_record %}
                            {{ ip.ptr_record }}
                        {% else %}
                            <button onclick="showPTRModal({{ ip.id }}, '{{ ip.ip_address }}')" class="text-blue-600 hover:text-blue-900">Set PTR</button>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm space-x-3">
                        {% if ip.type == 'shared' and not ip.is_default %}
                            <form action="/admin/ip-addresses/{{ ip.id }}/set-default" method="POST" class="inline">
                                {{ csrf_field() | raw }}
                                <button type="submit" class="text-blue-600 hover:text-blue-900">Set Default</button>
                            </form>
                        {% endif %}
                        {% if ip.ptr_record %}
                            <button onclick="showPTRModal({{ ip.id }}, '{{ ip.ip_address }}', '{{ ip.ptr_record }}')" class="text-blue-600 hover:text-blue-900">Edit PTR</button>
                        {% endif %}
                        {% if ip.account_count == 0 and not ip.is_default %}
                            <form action="/admin/ip-addresses/{{ ip.id }}/delete" method="POST" class="inline" onsubmit="return confirm('Delete IP {{ ip.ip_address }}?');">
                                {{ csrf_field() | raw }}
                                <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No IP addresses</h3>
            <p class="mt-1 text-sm text-gray-500">Get started by adding your first IP address to the pool</p>
            <div class="mt-6">
                <button onclick="document.getElementById('addIPForm').classList.remove('hidden')" class="inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                    <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                    </svg>
                    Add IP Address
                </button>
            </div>
        </div>
        {% endif %}
    </div>

    <!-- Info Panel -->
    <div class="mt-8 bg-blue-50 rounded-lg p-6">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
                </svg>
            </div>
            <div class="ml-3 flex-1">
                <h3 class="text-sm font-medium text-blue-800">IP Address Types</h3>
                <div class="mt-2 text-sm text-blue-700">
                    <p><strong>Shared IPs:</strong> Used by multiple hosting accounts. Cost-effective for most users.</p>
                    <p class="mt-1"><strong>Dedicated IPs:</strong> Assigned to a single account. Required for SSL certificates (non-SNI), better email reputation, and direct IP access.</p>
                    <p class="mt-1"><strong>PTR Records:</strong> Reverse DNS records. Important for email deliverability.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PTR Record Modal -->
<div id="ptrModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex min-h-screen items-end justify-center px-4 pb-20 pt-4 text-center sm:block sm:p-0">
        <div onclick="document.getElementById('ptrModal').classList.add('hidden')" class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
        <div class="inline-block align-bottom bg-white rounded-lg px-4 pb-4 pt-5 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">
            <form id="ptrForm" method="POST">
                {{ csrf_field() | raw }}
                <div>
                    <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Update PTR Record</h3>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">IP Address</label>
                        <input type="text" id="ptrIP" readonly class="mt-1 block w-full rounded-md border-gray-300 bg-gray-50 shadow-sm sm:text-sm">
                    </div>
                    <div class="mt-4">
                        <label class="block text-sm font-medium text-gray-700">PTR Record (Reverse DNS)</label>
                        <input type="text" name="ptr_record" id="ptrRecord" placeholder="mail.example.com" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        <p class="mt-1 text-xs text-gray-500">Usually set to your mail server hostname</p>
                    </div>
                </div>
                <div class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3">
                    <button type="submit" class="inline-flex w-full justify-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 sm:col-start-2">
                        Update PTR
                    </button>
                    <button type="button" onclick="document.getElementById('ptrModal').classList.add('hidden')" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:col-start-1 sm:mt-0">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function showPTRModal(ipId, ipAddress, ptrRecord = '') {
    document.getElementById('ptrForm').action = '/admin/ip-addresses/' + ipId + '/ptr';
    document.getElementById('ptrIP').value = ipAddress;
    document.getElementById('ptrRecord').value = ptrRecord;
    document.getElementById('ptrModal').classList.remove('hidden');
}
</script>
{% endblock %}
